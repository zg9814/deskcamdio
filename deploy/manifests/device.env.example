# /etc/deskcamdio/device.env — device-specific overrides.
# Values here override the systemd unit defaults; keep secrets out of git.

# Platform select: raspberry_pi enables real camera/GPIO/system adapters.
DESKCAMDIO_PLATFORM=raspberry_pi

# Storage locations (defaults shown; usually no need to change).
DESKCAMDIO_DATA_DIR=/var/lib/deskcamdio
DESKCAMDIO_RUN_DIR=/run/deskcamdio
DESKCAMDIO_HEADLESS=0
SDL_VIDEODRIVER=kmsdrm
SDL_AUDIODRIVER=alsa
AUDIODEV=usb_output
# SDL's ALSA hotplug thread probes the Pulse compatibility PCM. Give libpulse
# a writable runtime path so the probe cannot spam read-only ~/.config errors.
PULSE_RUNTIME_PATH=/run/deskcamdio
DESKCAMDIO_ALSA_CARD=1
DESKCAMDIO_ALSA_CONTROL=Speaker

# Cloud backend (optional). Never commit real tokens.
# DESKCAMDIO_BACKEND_URL=https://api.example.com
# DESKCAMDIO_BACKEND_TOKEN=
# MIMO_API_KEY=

# Local ASR (optional): enable the per-round Zipformer worker subprocess.
# MODE accepts: local | local_zipformer (legacy alias) | cloud
DESKCAMDIO_ASR_MODE=local
DESKCAMDIO_ASR_MODEL_DIR=/home/fish/desktop-ai/models/zipformer-small-zh-int8
DESKCAMDIO_ASR_RUNTIME=onnx
DESKCAMDIO_ASR_THREADS=2
# Hard cap per transcription round in seconds; on expiry the worker is killed.
DESKCAMDIO_ASR_TIMEOUT=12
DESKCAMDIO_EC11_A=17
DESKCAMDIO_EC11_B=27
DESKCAMDIO_EC11_SW=22
